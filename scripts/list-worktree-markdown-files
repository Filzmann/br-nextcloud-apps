#!/usr/bin/env bash
set -euo pipefail

[[ $# -eq 1 ]] || {
    echo "Verwendung: $0 <git-repository>" >&2
    exit 2
}

repository="$1"
git -C "$repository" rev-parse --is-inside-work-tree >/dev/null

{
    git -C "$repository" ls-files -- '*.md'
    git -C "$repository" ls-files --others --exclude-standard -- '*.md'
} | LC_ALL=C sort -u | while IFS= read -r path; do
    if [[ -f "$repository/$path" ]]; then
        printf '%s\n' "$path"
    fi
done
