#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo 'Aufruf: teamcloud-staging-install <Archiv> <App-ID> <Commit> <SHA-256>' >&2
}

if [[ $# -ne 4 ]]; then
    usage
    exit 2
fi

archive="$1"
app_id="$2"
commit="$3"
expected_hash="$4"
incoming_root='/var/tmp/teamcloud-staging-incoming'
nextcloud_root='/var/www/vhosts/simonbeyer.de/teamcloud.simonbeyer.de'
php_bin='/opt/plesk/php/8.4/bin/php'
installer='/usr/local/libexec/teamcloud-staging/install-staging-app.sh'
state_dir='/var/lib/teamcloud-staging'

case "$app_id" in
    brtop|adplaner|brstunden|localbase|br_permission_matrix|adcalendar|adurlaub|orgsuite|adroom|adrecruitment) ;;
    *) echo "Nicht freigegebene App-ID: $app_id" >&2; exit 2 ;;
esac
if [[ ! "$commit" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ || ! "$expected_hash" =~ ^[0-9a-f]{64}$ ]]; then
    echo 'Ungültige Commit-ID oder SHA-256-Prüfsumme.' >&2
    exit 2
fi
if [[ ! "$archive" =~ ^${incoming_root}/[0-9]+-[0-9]+-${app_id}/${app_id}\.tar\.gz$ ]]; then
    echo 'Archiv liegt nicht im erlaubten app-spezifischen Incoming-Pfad.' >&2
    exit 2
fi
if [[ ! -f "$archive" || -L "$archive" ]]; then
    echo 'Archiv fehlt, ist kein reguläres File oder ist ein Symlink.' >&2
    exit 2
fi
canonical_archive="$(realpath -e -- "$archive")"
if [[ "$canonical_archive" != "$archive" ]]; then
    echo 'Archivpfad ist nicht kanonisch.' >&2
    exit 2
fi
if [[ "$(stat -c '%U' -- "$archive")" != 'filzmann' ]]; then
    echo 'Archiv gehört nicht dem freigegebenen Upload-Benutzer.' >&2
    exit 2
fi
archive_size="$(stat -c '%s' -- "$archive")"
if [[ "$archive_size" -le 0 || "$archive_size" -gt 104857600 ]]; then
    echo 'Archivgröße liegt außerhalb des erlaubten Bereichs.' >&2
    exit 2
fi
if [[ ! -x "$installer" ]]; then
    echo "Root-eigener Staging-Installer fehlt: $installer" >&2
    exit 2
fi

exec "$installer" \
    --nextcloud-root "$nextcloud_root" \
    --php-bin "$php_bin" \
    --php-memory-limit 512M \
    --archive "$archive" \
    --sha256 "$expected_hash" \
    --app-id "$app_id" \
    --commit "$commit" \
    --state-dir "$state_dir"
