#!/usr/bin/env bash
set -euo pipefail

workspace="$(cd "$(dirname "$0")/.." && pwd)"
ddev_root="$workspace/nextcloud-dev"
override="$ddev_root/.ddev/docker-compose.zz-privacy-compat-test.yaml"
fixture_root=''
test_marker='# generated by check-privacy-app-compatibility'
privacy_should_be_disabled=0
matrix_should_be_disabled=0

fail() {
    echo "Privacy-App-Kompatibilitätscheck fehlgeschlagen: $*" >&2
    exit 1
}

ddev_is_stopped() {
    (cd "$ddev_root" && ddev describe -j) | php -r '
        $description = json_decode(stream_get_contents(STDIN), true);
        exit(($description["raw"]["status"] ?? null) === "stopped" ? 0 : 1);
    '
}

app_is_disabled() {
    local app_id="$1"
    ddev exec -d /var/www/html/html php occ app:list --output=json | php -r '
        $appId = $argv[1];
        $apps = json_decode(stream_get_contents(STDIN), true);
        exit(isset($apps["disabled"][$appId]) ? 0 : 1);
    ' "$app_id"
}

write_override() {
    local host_path="$1"
    printf '%s\n' \
        "$test_marker" \
        'services:' \
        '  web:' \
        '    volumes:' \
        "      - $host_path:/var/www/html/html/custom_apps/filzmann_data_protection:cached" \
        > "$override"
}

cleanup() {
    local cleanup_status=$?
    trap - EXIT INT TERM
    set +e

    if [[ -f "$override" ]] && grep -Fqx "$test_marker" "$override"; then
        rm -- "$override"
    fi
    if ! ddev_is_stopped; then
        ddev restart >/dev/null 2>&1
        if (( privacy_should_be_disabled )); then
            ddev exec -d /var/www/html/html php occ app:disable filzmann_data_protection >/dev/null 2>&1
        fi
        if (( matrix_should_be_disabled )); then
            ddev exec -d /var/www/html/html php occ app:disable filzmann_permission_matrix >/dev/null 2>&1
        fi
        ddev stop >/dev/null 2>&1
    fi
    if [[ -n "$fixture_root" && "$fixture_root" == /tmp/br-nextcloud-privacy-compat.* ]]; then
        rm -rf -- "$fixture_root"
    fi

    exit "$cleanup_status"
}
trap cleanup EXIT INT TERM

[[ ! -e "$override" ]] || fail "Temporärer Override existiert bereits: $override"
ddev_is_stopped || fail 'DDEV muss vor dem Check gestoppt sein.'

fixture_root="$(mktemp -d /tmp/br-nextcloud-privacy-compat.XXXXXX)"
missing_fixture="$fixture_root/missing"
incompatible_fixture="$fixture_root/incompatible"
mkdir -p "$missing_fixture" "$incompatible_fixture/appinfo"

printf '%s\n' \
    '<?xml version="1.0"?>' \
    '<info>' \
    '    <id>filzmann_data_protection</id>' \
    '    <name>Synthetic incompatible privacy app</name>' \
    '    <summary>Compatibility test fixture</summary>' \
    '    <description>Contains no executable provider code.</description>' \
    '    <version>99.0.0-test.1</version>' \
    '    <licence>agpl</licence>' \
    '    <author>Local compatibility test</author>' \
    '    <namespace>FilzmannDataProtection</namespace>' \
    '    <dependencies>' \
    '        <nextcloud min-version="99" max-version="99"/>' \
    '    </dependencies>' \
    '</info>' \
    > "$incompatible_fixture/appinfo/info.xml"

cd "$ddev_root"
ddev start
if app_is_disabled filzmann_data_protection; then
    privacy_should_be_disabled=1
else
    fail 'Die Privacy-App muss vor dem Check deaktiviert sein.'
fi
if app_is_disabled filzmann_permission_matrix; then
    matrix_should_be_disabled=1
else
    fail 'Die Permission-Matrix muss vor dem Check deaktiviert sein.'
fi
ddev exec -d /var/www/html/html php occ app:enable filzmann_permission_matrix

write_override "$missing_fixture"
ddev restart
ddev exec -d /var/www/html/html sh -c 'test ! -e custom_apps/filzmann_data_protection/appinfo/info.xml'
ddev exec -d /var/www/html/html php occ status
ddev exec -d /var/www/html/html php occ permission-matrix:status
echo 'Physisch fehlende Privacy-App: Matrix bleibt funktionsfähig.'

write_override "$incompatible_fixture"
ddev restart
incompatible_inventory="$(ddev exec -d /var/www/html/html php occ app:list --output=json)"
printf '%s' "$incompatible_inventory" | php -r '
    $apps = json_decode(stream_get_contents(STDIN), true);
    $status = $apps["disabled"]["filzmann_data_protection"] ?? "";
    exit(str_contains($status, "99.0.0-test.1") ? 0 : 1);
' || fail 'Nextcloud hat die inkompatible Privacy-App nicht kontrolliert erkannt.'

set +e
incompatibility_output="$(ddev exec -d /var/www/html/html php occ app:enable filzmann_data_protection 2>&1)"
incompatibility_status=$?
set -e
(( incompatibility_status != 0 )) || fail 'Die inkompatible Privacy-App wurde unerwartet aktiviert.'
[[ "$incompatibility_output" == *'not compatible with this version of the server'* ]] \
    || fail 'Der native Inkompatibilitätsgrund fehlt.'
printf 'Inkompatible Privacy-App: %s\n' "$incompatibility_output"
ddev exec -d /var/www/html/html php occ permission-matrix:status

rm -- "$override"
ddev restart
ddev exec -d /var/www/html/html sh -c 'test -e custom_apps/filzmann_data_protection/appinfo/info.xml'
app_is_disabled filzmann_data_protection || fail 'Der deaktivierte Privacy-Ausgangszustand wurde nicht wiederhergestellt.'
ddev exec -d /var/www/html/html php occ permission-matrix:status
ddev exec -d /var/www/html/html php occ app:disable filzmann_permission_matrix
app_is_disabled filzmann_permission_matrix || fail 'Der deaktivierte Matrix-Ausgangszustand wurde nicht wiederhergestellt.'
ddev stop

rm -rf -- "$fixture_root"
fixture_root=''
trap - EXIT INT TERM
echo 'Privacy-App-Kompatibilitätscheck: OK'
