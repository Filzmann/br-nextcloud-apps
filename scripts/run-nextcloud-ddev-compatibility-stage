#!/usr/bin/env bash
set -euo pipefail

fail() {
    echo "FEHLER: $*" >&2
    exit 1
}

(($# >= 5)) || fail 'Ungültiger Driver-Aufruf.'
mode="$1"
shift

case "$mode" in
    fresh)
        (($# == 4)) || fail 'fresh erwartet MAJOR SERVER_ROOT APPS_ROOT RESULT_DIR.'
        major="$1"
        initial_server="$2"
        apps_root="$3"
        result_dir="$4"
        target_server=''
        ;;
    upgrade)
        (($# == 6)) || fail 'upgrade erwartet FROM TO FROM_SERVER TO_SERVER APPS_ROOT RESULT_DIR.'
        major="$1"
        target_major="$2"
        initial_server="$3"
        target_server="$4"
        apps_root="$5"
        result_dir="$6"
        [[ "$target_major" =~ ^[0-9]+$ && "$target_major" -eq $((major + 1)) ]] \
            || fail 'Upgrade-Majors sind nicht benachbart.'
        ;;
    *)
        fail "Unbekannter Modus: $mode"
        ;;
esac

command -v ddev >/dev/null || fail 'ddev fehlt.'
command -v curl >/dev/null || fail 'curl fehlt.'
[[ ! -e "$result_dir" ]] || fail "Ergebnisverzeichnis existiert bereits: $result_dir"
mkdir -p "$result_dir"
project="$(mktemp -d /tmp/nextcloud-compatibility.XXXXXX)"
project_name="${NC_COMPAT_PROJECT_NAME:-nccompat${major}$(basename "$project" | tr -cd 'a-z0-9' | tail -c 7)}"
project_tld="${NC_COMPAT_PROJECT_TLD:-ddev.site}"
admin_user='compat-admin'
admin_password='compat-admin-development-only'
database_mode="${NC_COMPAT_DATABASE:-sqlite}"
[[ "$database_mode" == sqlite || "$database_mode" == postgresql ]] \
    || fail "Unbekannter NC_COMPAT_DATABASE-Modus: $database_mode"
object_storage_mode="${NC_COMPAT_OBJECT_STORAGE:-0}"
[[ "$object_storage_mode" == 0 || "$object_storage_mode" == 1 ]] \
    || fail "NC_COMPAT_OBJECT_STORAGE muss 0 oder 1 sein."
minio_source_root="${NC_COMPAT_MINIO_SOURCE_ROOT:-}"
minio_commit='0d7408fc9969caf07de6a8c3a84f9fbb10a6739e'
minio_builder='docker.io/library/golang@sha256:7772cb5322baa875edd74705556d08f0eeca7b9c4b5367754ce3f2f00041ccee'

validate_object_storage_source() {
    [[ "$object_storage_mode" == 1 ]] || return 0
    [[ -n "$minio_source_root" && -d "$minio_source_root/.git" ]] \
        || fail 'NC_COMPAT_MINIO_SOURCE_ROOT muss auf einen offiziellen, ausgecheckten MinIO-Quellstand zeigen.'
    [[ "$(git -C "$minio_source_root" rev-parse HEAD)" == "$minio_commit" ]] \
        || fail "MinIO-Quellstand ist nicht der gepinnte Commit $minio_commit."
    [[ -f "$minio_source_root/go.mod" && -f "$minio_source_root/go.sum" ]] \
        || fail 'Der gepinnte MinIO-Quellstand enthält keine vollständigen Go-Modul-Locks.'
}

cleanup() {
    (cd "$project" && ddev stop --unlist) >/dev/null 2>&1 || true
    rm -rf "$project"
}
trap cleanup EXIT

copy_server() {
    local source="$1"
    mkdir -p "$project/html"
    tar -C "$source" --exclude='./config/config.php' --exclude='./data' --exclude='./custom_apps' -cf - . \
        | tar -C "$project/html" -xf -
    mkdir -p "$project/html/config" "$project/html/custom_apps"
    cat > "$project/html/config/compatibility.config.php" <<'PHP'
<?php
$CONFIG = [
    'appstoreenabled' => false,
    'apps_paths' => [
        ['path' => __DIR__ . '/../apps', 'url' => '/apps', 'writable' => false],
        ['path' => __DIR__ . '/../custom_apps', 'url' => '/custom_apps', 'writable' => true],
    ],
];
PHP
    if [[ "$object_storage_mode" == 1 ]]; then
        cat >> "$project/html/config/compatibility.config.php" <<'PHP'
$CONFIG['objectstore'] = [
    'class' => '\\OC\\Files\\ObjectStore\\S3',
    'arguments' => [
        'bucket' => 'nextcloud-compatibility',
        'autocreate' => true,
        'key' => 'compatibility-access-key',
        'secret' => 'compatibility-secret-key',
        'hostname' => 'objectstore',
        'port' => 9000,
        'use_ssl' => false,
        'use_path_style' => true,
    ],
];
PHP
    fi
}

copy_app_snapshots() {
    local source destination
    mkdir -p "$project/html/.compatibility-app-tests"
    while IFS= read -r source; do
        destination="$project/html/.compatibility-app-tests/$(basename "$source")"
        mkdir -p "$destination"
        tar -C "$source" -cf - . | tar -C "$destination" -xf -
    done < <(find "$apps_root" -mindepth 1 -maxdepth 1 -type d -print | sort)
}

validate_app_smoke_contracts() {
    local app contract
    while IFS= read -r app; do
        [[ "$app" == localbase ]] && continue
        contract="$project/html/.compatibility-app-tests/$app/tests/nextcloud-compatibility-smoke.php"
        [[ -f "$contract" ]] || fail "App-lokaler Compatibility-Smoke fehlt: $app"
        php -l "$contract" >/dev/null
    done < <(find "$project/html/.compatibility-app-tests" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)
}

install_app_snapshots() {
    local effective_major="$1"
    local app source destination
    while IFS= read -r source; do
        app="$(basename "$source")"
        destination="$project/html/custom_apps/$app"
        install_app_snapshot "$source" "$destination" "$effective_major"
    done < <(find "$project/html/.compatibility-app-tests" -mindepth 1 -maxdepth 1 -type d -print | sort)
    rm -rf "$project/html/.compatibility-app-tests"
}

install_app_snapshot() {
    local source="$1"
    local destination="$2"
    local effective_major="$3"
    mkdir -p "$destination"
    tar -C "$source" -cf - . | tar -C "$destination" -xf -
    php -r '
        $path=$argv[1]; $major=(int)$argv[2];
        $xml=simplexml_load_file($path);
        if ($xml === false) throw new RuntimeException("Invalid app XML");
        $dependency=$xml->dependencies->nextcloud;
        $min=(int)$dependency["min-version"];
        $max=(int)$dependency["max-version"];
        if ($major < $min) $dependency["min-version"]=(string)$major;
        if ($major > $max) $dependency["max-version"]=(string)$major;
        $xml->asXML($path);
    ' "$destination/appinfo/info.xml" "$effective_major"
}

write_ddev_config() {
    mkdir -p "$project/.ddev"
    if [[ "$database_mode" == postgresql ]]; then
        cat > "$project/.ddev/config.yaml" <<YAML
name: $project_name
type: php
docroot: html
php_version: "8.3"
webserver_type: apache-fpm
database:
  type: postgres
  version: "16"
use_dns_when_possible: true
project_tld: $project_tld
YAML
        return
    fi
    cat > "$project/.ddev/config.yaml" <<YAML
name: $project_name
type: php
docroot: html
php_version: "8.3"
webserver_type: apache-fpm
database:
  type: mariadb
  version: "10.11"
omit_containers:
  - db
use_dns_when_possible: true
project_tld: $project_tld
YAML
}

write_object_storage_config() {
    [[ "$object_storage_mode" == 1 ]] || return 0
    cat > "$project/.ddev/Dockerfile.object-storage" <<EOF
FROM $minio_builder AS build
WORKDIR /src
COPY . .
RUN go build -tags kqueue -trimpath -ldflags='-s -w' -o /minio .
FROM scratch
COPY --from=build /minio /minio
ENTRYPOINT ["/minio"]
EOF
    cat > "$project/.ddev/docker-compose.object-storage.yaml" <<EOF
services:
  objectstore:
    build:
      context: $minio_source_root
      dockerfile: $project/.ddev/Dockerfile.object-storage
    command: server /data --address :9000
    environment:
      MINIO_ROOT_USER: compatibility-access-key
      MINIO_ROOT_PASSWORD: compatibility-secret-key
    tmpfs:
      - /data
EOF
}

start_project() {
    (cd "$project" && ddev start -y) > "$result_dir/ddev-start.log" 2>&1
}

occ() {
    (cd "$project" && ddev exec -d /var/www/html/html php occ "$@") </dev/null
}

create_compat_target() {
    (cd "$project" && ddev exec -d /var/www/html/html \
        env OC_PASS=compat-target-development-only php occ user:add --password-from-env \
        --display-name='Compatibility target' compat-target) </dev/null
}

install_core() {
    local effective_major="$1"
    if [[ "$database_mode" == postgresql ]]; then
        OC_PASS="$admin_password" occ maintenance:install \
            --database=pgsql --database-host=db --database-name=db \
            --database-user=db --database-pass=db \
            --admin-user="$admin_user" --admin-pass="$admin_password" \
            --no-interaction > "$result_dir/install-$effective_major.log" 2>&1
        occ config:system:set trusted_domains 1 --value="$project_name.$project_tld" >/dev/null
        create_compat_target >/dev/null
        return
    fi
    OC_PASS="$admin_password" occ maintenance:install \
        --database=sqlite \
        --admin-user="$admin_user" --admin-pass="$admin_password" \
        --no-interaction > "$result_dir/install-$effective_major.log" 2>&1
    occ config:system:set trusted_domains 1 --value="$project_name.$project_tld" >/dev/null
    create_compat_target >/dev/null
}

enable_apps() {
    local effective_major="$1"
    find "$project/html/custom_apps" -mindepth 1 -maxdepth 2 -printf '%P\n' | sort \
        > "$result_dir/custom-apps-host-$effective_major.txt"
    (cd "$project" && ddev exec -d /var/www/html/html \
        find custom_apps -mindepth 1 -maxdepth 2 -printf '%P\\n') \
        > "$result_dir/custom-apps-container-$effective_major.txt"
    occ config:system:get apps_paths --output=json \
        > "$result_dir/apps-paths-$effective_major.json"
    local app
    if [[ -d "$project/html/custom_apps/localbase" ]]; then
        occ app:enable localbase >> "$result_dir/enable-$effective_major.log" 2>&1
    fi
    while IFS= read -r app; do
        [[ "$app" == localbase ]] && continue
        occ app:enable "$app" >> "$result_dir/enable-$effective_major.log" 2>&1
    done < <(find "$project/html/custom_apps" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)
}

prepare_runtime_permissions() {
    local effective_major="$1"
    local base_url="https://$project_name.$project_tld"
    runtime_smokes pre "$effective_major" > "$result_dir/runtime-smokes-pre-$effective_major.tsv"
    verify_runtime_smoke_coverage pre "$result_dir/runtime-smokes-pre-$effective_major.tsv"
    local app path expected_statuses status
    while IFS=$'\t' read -r app path expected_statuses probe; do
        status="$(curl --silent --show-error --insecure --user "$admin_user:$admin_password" \
            --output /dev/null --write-out '%{http_code}' "$base_url$path")"
        [[ ",$expected_statuses," == *",$status,"* ]] \
            || fail "$app lieferte vor der App-Freigabe HTTP $status statt einem von $expected_statuses."
        printf '%s\t%s\t%s\t%s\n' "$app" "$expected_statuses" "$status" "$probe" \
            >> "$result_dir/permission-pregrant-$effective_major.tsv"
    done < "$result_dir/runtime-smokes-pre-$effective_major.tsv"

    runtime_smokes grant "$effective_major" > "$result_dir/permission-grants-$effective_major.log"
    verify_runtime_smoke_coverage grant "$result_dir/permission-grants-$effective_major.log"
}

write_runtime_smoke_runner() {
    cat > "$project/html/compatibility-grants.php" <<'PHP'
<?php
define('OC_CONSOLE', true);
$phase = $argv[1] ?? '';
if (!in_array($phase, ['pre', 'grant', 'describe', 'registrations', 'setup-providers', 'providers', 'apis', 'object-storage-job', 'postgresql-upgrade-seed', 'postgresql-upgrade-verify'], true)) {
    throw new RuntimeException('Unknown compatibility smoke phase.');
}
$registrationClasses = [];
if ($phase === 'registrations') {
    foreach (glob(__DIR__ . '/custom_apps/*', GLOB_ONLYDIR) ?: [] as $appRoot) {
        $app = basename($appRoot);
        if ($app === 'localbase') continue;
        $info = simplexml_load_file($appRoot . '/appinfo/info.xml', SimpleXMLElement::class, LIBXML_NONET);
        if ($info === false) throw new RuntimeException('Invalid app metadata for ' . $app);
        foreach (['background-jobs/job', 'commands/command', 'settings/*'] as $expression) {
            foreach ($info->xpath($expression) ?: [] as $node) {
                $registrationClasses[$app][$expression][] = (string)$node;
            }
        }
    }
}
require __DIR__ . '/lib/base.php';
$uid = 'compat-admin';
$users = \OCP\Server::get(\OCP\IUserManager::class);
$session = \OCP\Server::get(\OCP\IUserSession::class);
$user = $users->get($uid);
if ($user === null) throw new RuntimeException('Compatibility admin is missing.');
$session->setUser($user);
$providerEvents = [];

try {
    $appRoots = glob(__DIR__ . '/custom_apps/*', GLOB_ONLYDIR) ?: [];
    sort($appRoots);
    foreach ($appRoots as $appRoot) {
    $app = basename($appRoot);
    if ($app === 'localbase') continue;
    if (in_array($phase, ['describe', 'apis'], true)
        && !\OCP\Server::get(\OCP\App\IAppManager::class)->isEnabledForUser($app)) {
        continue;
    }
    $contractPath = $appRoot . '/tests/nextcloud-compatibility-smoke.php';
    if (!is_file($contractPath)) {
        throw new RuntimeException('Compatibility smoke contract is missing for ' . $app);
    }
    $contract = require $contractPath;
    foreach (['uiPath', 'preGrantUiStatuses', 'postGrantUiStatuses', 'grantService', 'permissionProbe', 'apiSmokes'] as $key) {
        if (!array_key_exists($key, $contract)) {
            throw new RuntimeException('Compatibility smoke key is missing for ' . $app . ': ' . $key);
        }
    }
    $probe = $contract['permissionProbe'];
    if ($phase === 'setup-providers') {
        if (isset($contract['providerSetup']) && is_callable($contract['providerSetup'])) {
            ($contract['providerSetup'])();
        }
        echo implode("\t", [$app, 'setup-complete']) . "\n";
        continue;
    }
    if ($phase === 'providers') {
        if (!isset($contract['providerRegistrations']) || !is_array($contract['providerRegistrations'])) {
            throw new RuntimeException('Provider registration expectations are missing for ' . $app);
        }
        foreach ($contract['providerRegistrations'] as $owner => $eventClasses) {
            if (!\OCP\Server::get(\OCP\App\IAppManager::class)->isEnabledForUser($owner)) {
                echo implode("\t", [$app, $owner, 'owner-unavailable']) . "\n";
                continue;
            }
            foreach ($eventClasses as $eventClass) {
                if (!isset($providerEvents[$eventClass])) {
                    $event = new $eventClass();
                    \OCP\Server::get(\OCP\EventDispatcher\IEventDispatcher::class)->dispatchTyped($event);
                    if (method_exists($event, 'registrationFailures') && $event->registrationFailures() !== []) {
                        throw new RuntimeException('Provider registration failed for ' . $eventClass);
                    }
                    $providerEvents[$eventClass] = $event->providers();
                }
                if (!isset($providerEvents[$eventClass][$app])) {
                    throw new RuntimeException('Provider missing after installation: ' . $app . ' / ' . $eventClass);
                }
                echo implode("\t", [$app, $eventClass, 'registered']) . "\n";
            }
        }
        continue;
    }
    if ($phase === 'registrations') {
        foreach ($registrationClasses[$app] ?? [] as $expression => $classes) {
            foreach ($classes as $class) {
                $instance = \OCP\Server::get($class);
                echo implode("\t", [$app, $expression, $class, get_debug_type($instance)]) . "\n";
            }
        }
        continue;
    }
    if ($phase === 'apis') {
        foreach ($contract['apiSmokes'] as [$path, $statuses]) {
            echo implode("\t", [$app, $path, implode(',', $statuses)]) . "\n";
        }
        continue;
    }
    if ($phase === 'object-storage-job') {
        if (isset($contract['objectStorageJobVerify'])) {
            if (!is_callable($contract['objectStorageJobVerify'])) {
                throw new RuntimeException('Object-storage job verifier is invalid for ' . $app);
            }
            ($contract['objectStorageJobVerify'])($uid);
            echo implode("\t", [$app, 'object-storage-job-verified']) . "\n";
        } else {
            echo implode("\t", [$app, 'object-storage-not-applicable']) . "\n";
        }
        continue;
    }
    if (in_array($phase, ['postgresql-upgrade-seed', 'postgresql-upgrade-verify'], true)) {
        $key = $phase === 'postgresql-upgrade-seed' ? 'postgresqlUpgradeSeed' : 'postgresqlUpgradeVerify';
        if (isset($contract[$key])) {
            if (!is_callable($contract[$key])) {
                throw new RuntimeException('PostgreSQL upgrade callback is invalid for ' . $app . ': ' . $key);
            }
            ($contract[$key])($uid);
            echo implode("\t", [$app, $phase, 'verified']) . "\n";
        } else {
            echo implode("\t", [$app, $phase, 'not-applicable']) . "\n";
        }
        continue;
    }
    if ($phase === 'pre' && is_callable($probe) && $probe($uid) !== false) {
        throw new RuntimeException('Protected capability is unexpectedly available before grant for ' . $app);
    }
    if ($phase === 'grant' && isset($contract['grantManagerGroups'])) {
        $grantManagerGroups = is_callable($contract['grantManagerGroups'])
            ? ($contract['grantManagerGroups'])()
            : $contract['grantManagerGroups'];
        if (!is_array($grantManagerGroups)) {
            throw new RuntimeException('Grant-manager groups are invalid for ' . $app);
        }
        $groups = \OCP\Server::get(\OCP\IGroupManager::class);
        foreach ($grantManagerGroups as $groupId) {
            if (!is_string($groupId) || trim($groupId) === '') {
                throw new RuntimeException('Grant-manager group is invalid for ' . $app);
            }
            $group = $groups->get($groupId) ?? $groups->createGroup($groupId);
            if ($group === null) throw new RuntimeException('Grant-manager group could not be created for ' . $app);
            $group->addUser($user);
        }
    }
    if ($phase === 'grant' && is_string($contract['grantService'])) {
        $service = \OCP\Server::get($contract['grantService']);
        $service->activate($uid, 60);
        if (!$service->hasActiveGrant($uid)) {
            throw new RuntimeException('Temporary grant is inactive for ' . $app);
        }
    }
    if ($phase === 'grant' && is_callable($contract['grantService'])) {
        ($contract['grantService'])($uid);
    }
    if ($phase === 'grant' && is_callable($probe) && $probe($uid) !== true) {
        throw new RuntimeException('Protected capability remains unavailable after grant for ' . $app);
    }
    $statuses = $phase === 'pre' ? $contract['preGrantUiStatuses'] : $contract['postGrantUiStatuses'];
    $probeState = is_callable($probe) ? ($probe($uid) ? 'allowed' : 'denied') : 'not-applicable';
        echo implode("\t", [$app, $contract['uiPath'], implode(',', $statuses), $probeState]) . "\n";
    }
} catch (\Throwable $error) {
    fwrite(STDERR, get_class($error) . ': ' . $error->getMessage() . "\n");
    exit(1);
}
PHP
}

write_app_object_storage_probe() {
    [[ "$object_storage_mode" == 1 ]] || return 0
    cat > "$project/html/compatibility-app-object-storage.php" <<'PHP'
<?php
declare(strict_types=1);

if (($_SERVER['PHP_AUTH_USER'] ?? '') !== 'compat-admin'
    || ($_SERVER['PHP_AUTH_PW'] ?? '') !== 'compat-admin-development-only') {
    header('WWW-Authenticate: Basic realm="Nextcloud compatibility"');
    http_response_code(401);
    exit;
}

require __DIR__ . '/lib/base.php';
header('Content-Type: text/plain; charset=utf-8');
$uid = 'compat-admin';
$users = \OCP\Server::get(\OCP\IUserManager::class);
$session = \OCP\Server::get(\OCP\IUserSession::class);
$user = $users->get($uid);
if ($user === null) throw new RuntimeException('Compatibility admin is missing.');
$session->setUser($user);

try {
    $appRoots = glob(__DIR__ . '/custom_apps/*', GLOB_ONLYDIR) ?: [];
    sort($appRoots);
    foreach ($appRoots as $appRoot) {
        $app = basename($appRoot);
        if ($app === 'localbase') continue;
        $contract = require $appRoot . '/tests/nextcloud-compatibility-smoke.php';
        if (isset($contract['objectStorageWebSetup'])) {
            if (!is_callable($contract['objectStorageWebSetup'])) {
                throw new RuntimeException('Object-storage web setup is invalid for ' . $app);
            }
            ($contract['objectStorageWebSetup'])($uid);
            echo implode("\t", [$app, 'object-storage-web-setup']) . "\n";
        } else {
            echo implode("\t", [$app, 'object-storage-not-applicable']) . "\n";
        }
    }
} catch (\Throwable $error) {
    http_response_code(500);
    echo $error::class . ': ' . $error->getMessage() . "\n";
}
PHP
}

write_object_storage_probe() {
    [[ "$object_storage_mode" == 1 ]] || return 0
    cat > "$project/html/compatibility-object-storage.php" <<'PHP'
<?php
define('OC_CONSOLE', true);
require __DIR__ . '/lib/base.php';

$uid = 'compat-admin';
$users = \OCP\Server::get(\OCP\IUserManager::class);
$session = \OCP\Server::get(\OCP\IUserSession::class);
$user = $users->get($uid);
if ($user === null) throw new RuntimeException('Compatibility admin is missing.');
$session->setUser($user);
$root = \OCP\Server::get(\OCP\Files\IRootFolder::class);
$folder = $root->getUserFolder($uid);
$name = 'compatibility-object-storage.txt';
$file = $folder->get($name);
if (!$file instanceof \OCP\Files\File) throw new RuntimeException('Object-storage probe is not a file.');
if ($file->getContent() !== 'object-storage-web-write') throw new RuntimeException('Object-storage probe content differs.');
$file->delete();
echo "object-storage-job-read-and-cleaned\n";
PHP
}

runtime_smokes() {
    local phase="$1"
    local effective_major="$2"
    (cd "$project" && ddev exec -d /var/www/html/html php compatibility-grants.php "$phase") </dev/null
}

verify_runtime_smoke_coverage() {
    local phase="$1"
    local file="$2"
    local excluded_app="${3:-}"
    local expected actual expected_rows rows
    expected="$(find "$project/html/custom_apps" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' \
        | grep -Fvx 'localbase' | { if [[ -n "$excluded_app" ]]; then grep -Fvx "$excluded_app"; else cat; fi; } | sort || true)"
    actual="$(cut -f1 "$file" | sed '/^$/d' | sort -u)"
    expected_rows="$(printf '%s\n' "$expected" | sed '/^$/d' | wc -l)"
    rows="$(sed '/^$/d' "$file" | wc -l)"
    if [[ "$actual" != "$expected" || "$rows" -ne "$expected_rows" ]]; then
        fail "Runtime-Smoke $phase ist unvollständig; erwartet: ${expected:-keine}; erhalten: ${actual:-keine}."
    fi
}

verify_consumer_runtime() {
    local effective_major="$1"
    local suffix="$2"
    local excluded_app="${3:-}"
    local base_url="https://$project_name.$project_tld"
    local app path expected_statuses status

    runtime_smokes setup-providers "$effective_major" > "$result_dir/provider-setup-$suffix.tsv"
    runtime_smokes providers "$effective_major" > "$result_dir/providers-$suffix.tsv"
    runtime_smokes describe "$effective_major" > "$result_dir/runtime-smokes-$suffix-all.tsv"
    if [[ -n "$excluded_app" ]]; then
        awk -F $'\t' -v excluded="$excluded_app" '$1 != excluded' "$result_dir/runtime-smokes-$suffix-all.tsv" \
            > "$result_dir/runtime-smokes-$suffix.tsv"
    else
        cp "$result_dir/runtime-smokes-$suffix-all.tsv" "$result_dir/runtime-smokes-$suffix.tsv"
    fi
    verify_runtime_smoke_coverage describe "$result_dir/runtime-smokes-$suffix.tsv" "$excluded_app"
    while IFS=$'\t' read -r app path expected_statuses probe; do
        status="$(curl --silent --show-error --insecure --user "$admin_user:$admin_password" --output "$result_dir/ui-$app-$suffix.html" --write-out '%{http_code}' "$base_url$path")"
        [[ ",$expected_statuses," == *",$status,"* ]] \
            || fail "$app UI lieferte HTTP $status statt einem von $expected_statuses auf Nextcloud $effective_major."
    done < "$result_dir/runtime-smokes-$suffix.tsv"

    runtime_smokes apis "$effective_major" > "$result_dir/api-smokes-$suffix-all.tsv"
    if [[ -n "$excluded_app" ]]; then
        awk -F $'\t' -v excluded="$excluded_app" '$1 != excluded' "$result_dir/api-smokes-$suffix-all.tsv" \
            > "$result_dir/api-smokes-$suffix.tsv"
    else
        cp "$result_dir/api-smokes-$suffix-all.tsv" "$result_dir/api-smokes-$suffix.tsv"
    fi
    while IFS=$'\t' read -r app path expected_statuses; do
        status="$(curl --silent --show-error --insecure --user "$admin_user:$admin_password" \
            --header 'OCS-APIRequest: true' --output "$result_dir/api-$app-$suffix.json" \
            --write-out '%{http_code}' "$base_url$path")"
        [[ ",$expected_statuses," == *",$status,"* ]] \
            || fail "$app API lieferte HTTP $status statt einem von $expected_statuses auf Nextcloud $effective_major."
    done < "$result_dir/api-smokes-$suffix.tsv"
}
replace_lifecycle_snapshots() {
    local snapshots_root="$1"
    local effective_major="$2"
    local provider="$3"
    local phase="$4"
    local provider_already_disabled="$5"
    local source app destination expected_version
    [[ -d "$snapshots_root" ]] || fail "Lifecycle-Snapshotverzeichnis fehlt: $snapshots_root"
    mapfile -t lifecycle_sources < <(find "$snapshots_root" -mindepth 1 -maxdepth 1 -type d -print | sort)
    ((${#lifecycle_sources[@]} > 0)) || fail "Lifecycle-Snapshots fehlen: $snapshots_root"

    for source in "${lifecycle_sources[@]}"; do
        app="$(basename "$source")"
        destination="$project/html/custom_apps/$app"
        [[ -d "$destination" ]] || fail "Lifecycle-App ist nicht installiert: $app"
        if [[ "$app" == "$provider" && "$provider_already_disabled" == 1 ]]; then
            continue
        fi
        occ app:disable "$app" >> "$result_dir/lifecycle-$provider-$phase-disable-$effective_major.log" 2>&1
    done
    for source in "${lifecycle_sources[@]}"; do
        app="$(basename "$source")"
        destination="$project/html/custom_apps/$app"
        rm -rf "$destination"
        install_app_snapshot "$source" "$destination" "$effective_major"
    done
    for app in localbase "$provider"; do
        [[ -d "$snapshots_root/$app" ]] || continue
        occ app:enable "$app" >> "$result_dir/lifecycle-$provider-$phase-enable-$effective_major.log" 2>&1
    done
    for source in "${lifecycle_sources[@]}"; do
        app="$(basename "$source")"
        [[ "$app" == localbase || "$app" == "$provider" ]] && continue
        occ app:enable "$app" >> "$result_dir/lifecycle-$provider-$phase-enable-$effective_major.log" 2>&1
    done
    occ app:list --output=json > "$result_dir/lifecycle-$provider-$phase-apps-$effective_major.json"
    for source in "${lifecycle_sources[@]}"; do
        app="$(basename "$source")"
        expected_version="$(php -r '$xml=simplexml_load_file($argv[1]); if ($xml === false) exit(2); echo (string)$xml->version;' "$source/appinfo/info.xml")"
        php -r '
            $apps=json_decode(file_get_contents($argv[1]),true,512,JSON_THROW_ON_ERROR);
            $actual=$apps["enabled"][$argv[2]]??null;
            if($actual!==$argv[3])throw new RuntimeException("Lifecycle app version mismatch: ".var_export($actual,true));
        ' "$result_dir/lifecycle-$provider-$phase-apps-$effective_major.json" "$app" "$expected_version"
    done
}

verify_optional_provider_lifecycle() {
    local effective_major="$1"
    local provider="${NC_COMPAT_OPTIONAL_PROVIDER_LIFECYCLE:-}"
    [[ -n "$provider" ]] || return 0
    [[ "$provider" =~ ^[a-z][a-z0-9_]*$ ]] || fail "Ungültige optionale Provider-App-ID: $provider"
    local reinstall_source="$apps_root/$provider"
    local update_root="${NC_COMPAT_UPDATE_APPS_ROOT:-}"
    local rollback_root="${NC_COMPAT_ROLLBACK_APPS_ROOT:-}"
    [[ -d "$reinstall_source" && -d "$project/html/custom_apps/$provider" ]] \
        || fail "Optionaler Lifecycle-Provider fehlt im Prüflauf: $provider"

    if [[ -n "$update_root" && -d "$update_root/localbase" && "$provider" == localbase ]]; then
        local organization_state
        organization_state="$(php -r '
            require $argv[1];
            echo json_encode(\OCA\LocalBase\Organization\FlzOrganizationDefinition::defaults()->toArray(), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR);
        ' "$project/html/custom_apps/$provider/lib/Organization/FlzOrganizationDefinition.php")"
        occ config:app:set "$provider" flz_organization_definition --value="$organization_state" \
            > "$result_dir/lifecycle-$provider-update-state-seed-$effective_major.log" 2>&1
        occ config:app:get "$provider" flz_organization_definition \
            > "$result_dir/lifecycle-$provider-update-state-before-$effective_major.json"
    fi

    if [[ -n "$update_root" ]]; then
        replace_lifecycle_snapshots "$update_root" "$effective_major" "$provider" update 0
        if [[ "$provider" == localbase && -f "$result_dir/lifecycle-$provider-update-state-before-$effective_major.json" ]]; then
            occ config:app:get "$provider" flz_organization_definition \
                > "$result_dir/lifecycle-$provider-update-state-after-$effective_major.json"
            cmp -s "$result_dir/lifecycle-$provider-update-state-before-$effective_major.json" \
                "$result_dir/lifecycle-$provider-update-state-after-$effective_major.json" \
                || fail "Persistierter LocalBase-Organisationszustand änderte sich beim In-place-Update."
        fi
        verify_consumer_runtime "$effective_major" "$provider-updated-$effective_major"
        [[ -d "$update_root/$provider" ]] && reinstall_source="$update_root/$provider"
    fi

    occ app:disable "$provider" > "$result_dir/lifecycle-$provider-disable-$effective_major.log" 2>&1
    verify_consumer_runtime "$effective_major" "$provider-disabled-$effective_major" "$provider"

    occ app:remove "$provider" > "$result_dir/lifecycle-$provider-remove-$effective_major.log" 2>&1
    [[ ! -e "$project/html/custom_apps/$provider" ]] \
        || fail "Providercode blieb nach app:remove vorhanden: $provider"
    verify_consumer_runtime "$effective_major" "$provider-removed-$effective_major" "$provider"

    install_app_snapshot "$reinstall_source" "$project/html/custom_apps/$provider" "$effective_major"
    occ app:enable "$provider" > "$result_dir/lifecycle-$provider-reenable-$effective_major.log" 2>&1
    verify_consumer_runtime "$effective_major" "$provider-reenabled-$effective_major"

    if [[ -n "$rollback_root" ]]; then
        replace_lifecycle_snapshots "$rollback_root" "$effective_major" "$provider" rollback 0
        verify_consumer_runtime "$effective_major" "$provider-rollback-$effective_major"
    fi
}
verify_app_tests() {
    local effective_major="$1"
    local app app_root
    while IFS= read -r app; do
        app_root="/var/www/html/html/.compatibility-app-tests/$app"
        if [[ -f "$project/html/.compatibility-app-tests/$app/tests/run.php" ]]; then
            (cd "$project" && ddev exec -d "$app_root" php tests/run.php) </dev/null \
                > "$result_dir/preflight-$app-php-$effective_major.log" 2>&1
        fi
        if [[ -f "$project/html/.compatibility-app-tests/$app/tests/run-js.mjs" ]]; then
            (cd "$project" && ddev exec -d "$app_root" node tests/run-js.mjs) </dev/null \
                > "$result_dir/preflight-$app-js-$effective_major.log" 2>&1
        fi
    done < <(find "$project/html/.compatibility-app-tests" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)
}

verify_runtime() {
    local effective_major="$1"
    occ status --output=json > "$result_dir/status-$effective_major.json"
    occ app:list --output=json > "$result_dir/apps-$effective_major.json"
    php -r '
        $status=json_decode(file_get_contents($argv[1]),true,512,JSON_THROW_ON_ERROR);
        if (!($status["installed"]??false) || ($status["maintenance"]??true) || ($status["needsDbUpgrade"]??true)) exit(1);
        $apps=json_decode(file_get_contents($argv[2]),true,512,JSON_THROW_ON_ERROR);
        foreach (array_slice($argv,3) as $app) if (!isset($apps["enabled"][$app])) throw new RuntimeException("Not enabled: ".$app);
    ' "$result_dir/status-$effective_major.json" "$result_dir/apps-$effective_major.json" \
        $(find "$project/html/custom_apps" -mindepth 1 -maxdepth 1 -type d -printf '%f ' | sort)

    occ list --raw > "$result_dir/commands-$effective_major.txt"
    if grep -Fqx 'app:check-code' "$result_dir/commands-$effective_major.txt"; then
        local app
        while IFS= read -r app; do
            occ app:check-code "$app" >> "$result_dir/check-code-$effective_major.log" 2>&1
        done < <(find "$project/html/custom_apps" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)
    fi
    runtime_smokes registrations "$effective_major" > "$result_dir/registrations-$effective_major.tsv"
    occ background-job:list --output=json > "$result_dir/background-jobs-$effective_major.json"
    php -r '
        $jobs=json_decode(file_get_contents($argv[1]),true,512,JSON_THROW_ON_ERROR);
        $values=[];
        $walk=function($value)use(&$walk,&$values):void{if(is_array($value)){foreach($value as $item)$walk($item);}elseif(is_string($value))$values[]=$value;};
        $walk($jobs);
        foreach(array_slice($argv,2) as $infoPath){
            $info=simplexml_load_file($infoPath);
            foreach($info->xpath("background-jobs/job") ?: [] as $job){
                $class=(string)$job;
                if(!in_array($class,$values,true))throw new RuntimeException("Background job is not registered: ".$class);
            }
        }
    ' "$result_dir/background-jobs-$effective_major.json" \
        $(find "$project/html/custom_apps" -mindepth 3 -maxdepth 3 -path '*/appinfo/info.xml' -print | sort)

    local base_url="https://$project_name.$project_tld"
    curl --fail --silent --show-error --insecure "$base_url/status.php" > "$result_dir/http-status-$effective_major.json"
    local app asset content_type
    while IFS= read -r app; do
        asset="$(find "$project/html/custom_apps/$app" -type f \( -path '*/css/*.css' -o -path '*/js/*.js' \) -printf '%P\n' | sort | head -n 1)"
        if [[ -n "$asset" ]]; then
            content_type="$(curl --fail --silent --show-error --insecure --output /dev/null --write-out '%{content_type}' "$base_url/custom_apps/$app/$asset")"
            case "$asset:$content_type" in
                *.css:text/css*|*.js:application/javascript*|*.js:text/javascript*) ;;
                *) fail "Falscher Content-Type für $app/$asset: $content_type" ;;
            esac
            printf '%s\t%s\t%s\n' "$app" "$asset" "$content_type" >> "$result_dir/assets-$effective_major.tsv"
        fi

    done < <(find "$project/html/custom_apps" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)

    verify_consumer_runtime "$effective_major" "$effective_major"
}

verify_object_storage_runtime() {
    [[ "$object_storage_mode" == 1 ]] || return 0
    local effective_major="$1"
    local base_url="https://$project_name.$project_tld"
    curl --fail --silent --show-error --insecure --user "$admin_user:$admin_password" \
        --request PUT --data 'object-storage-web-write' \
        "$base_url/remote.php/dav/files/$admin_user/compatibility-object-storage.txt" \
        > "$result_dir/object-storage-web-write-$effective_major.log"
    curl --fail --silent --show-error --insecure --user "$admin_user:$admin_password" \
        "$base_url/compatibility-app-object-storage.php" \
        > "$result_dir/object-storage-app-web-$effective_major.tsv"
    verify_runtime_smoke_coverage object-storage-web "$result_dir/object-storage-app-web-$effective_major.tsv"
    runtime_smokes object-storage-job "$effective_major" \
        > "$result_dir/object-storage-job-contract-$effective_major.tsv"
    verify_runtime_smoke_coverage object-storage-job "$result_dir/object-storage-job-contract-$effective_major.tsv"
    (cd "$project" && ddev exec -d /var/www/html/html php compatibility-object-storage.php) </dev/null \
        > "$result_dir/object-storage-job-$effective_major.log"
    grep -Fqx 'object-storage-job-read-and-cleaned' "$result_dir/object-storage-job-$effective_major.log" \
        || fail 'Der neue Jobprozess konnte den über HTTP geschriebenen Object-Storage-Wert nicht lesen und bereinigen.'
}

verify_postgresql_upgrade_runtime() {
    [[ "$mode" == upgrade && "$database_mode" == postgresql ]] || return 0
    local phase="$1"
    local effective_major="$2"
    local output="$result_dir/$phase-$effective_major.tsv"
    local dbtype
    dbtype="$(occ config:system:get dbtype)"
    [[ "$dbtype" == pgsql ]] || fail "PostgreSQL-Upgrade-Smoke lief unerwartet gegen $dbtype."
    printf '%s\n' "$dbtype" > "$result_dir/postgresql-dbtype-$effective_major.txt"
    runtime_smokes "$phase" "$effective_major" > "$output"
    verify_runtime_smoke_coverage "$phase" "$output"
}

copy_server "$initial_server"
validate_object_storage_source
copy_app_snapshots
validate_app_smoke_contracts
write_ddev_config
write_object_storage_config
start_project
verify_app_tests "$major"
install_core "$major"
install_app_snapshots "$major"
enable_apps "$major"
write_runtime_smoke_runner
write_app_object_storage_probe
write_object_storage_probe
prepare_runtime_permissions "$major"
verify_runtime "$major"
verify_object_storage_runtime "$major"
if [[ "$mode" == fresh ]]; then
    verify_optional_provider_lifecycle "$major"
fi

if [[ "$mode" == upgrade ]]; then
    verify_postgresql_upgrade_runtime postgresql-upgrade-seed "$major"
    (cd "$project" && ddev stop) > "$result_dir/ddev-stop-before-upgrade.log" 2>&1
    find "$project/html" -mindepth 1 -maxdepth 1 \
        ! -name config ! -name data ! -name custom_apps -exec rm -rf {} +
    tar -C "$target_server" --exclude='./config' --exclude='./data' --exclude='./custom_apps' -cf - . \
        | tar -C "$project/html" -xf -
    write_runtime_smoke_runner
    start_project
    occ upgrade > "$result_dir/upgrade-$major-$target_major.log" 2>&1
    verify_postgresql_upgrade_runtime postgresql-upgrade-verify "$target_major"
    verify_runtime "$target_major"
fi

printf 'green\n' > "$result_dir/result.txt"
